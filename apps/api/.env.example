# ---------------------------------------------------------------
# HeavyHire API settings. Copy this file to .env and fill it in.
# Anything marked (optional) can stay empty while developing:
# the app then uses a safe "dev mode" (OTP printed in the terminal,
# fake payments, uploads saved on your computer).
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public URLs (used for CORS and links in WhatsApp messages)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL connection
DATABASE_URL=postgresql://USER@localhost:5432/heavyhire

# Long random strings. Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
FILE_URL_SECRET=

# Phone that becomes ADMIN when you run the seed (10 digits)
ADMIN_PHONE=

# MSG91: OTP SMS + WhatsApp (optional in development)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_WHATSAPP_NUMBER=

# Razorpay (optional in development: fake payments are used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional in development: files saved in apps/api/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
